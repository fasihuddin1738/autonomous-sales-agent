# Copy to .env and fill in. Everything works without these set (deterministic
# fallbacks kick in), so don't block the demo on getting these keys.

RESEND_API_KEY=
EMAIL_FROM=outreach@nexaflow.ai
EMAIL_REPLY_TO=

ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6

FOLLOW_UP_DELAY_DAYS=3
MAX_FOLLOW_UPS=1
BRIEFING_LEAD_TIME_MIN=30

DATABASE_URL=sqlite:///./nexaflow_pipeline.db
