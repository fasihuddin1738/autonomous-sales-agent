OPENAI_API_KEY=
TAVILY_API_KEY=
RESEND_API_KEY=
DATABASE_URL=

# --- research/ module (feature/research-qualify) ---
# Toggle: "mock" (default, no API keys needed) or "live" (real search + LLM)
RESEARCH_MODE=mock

# LLM provider for live research extraction: "anthropic" (default) or "openai"
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# LLM_MODEL is optional — defaults to claude-sonnet-4-6 (anthropic) or gpt-4o-mini (openai)
# LLM_MODEL=

# Search provider for live research: "tavily" (default) or "serper"
SEARCH_PROVIDER=tavily
# TAVILY_API_KEY already listed above (shared key)
SERPER_API_KEY=