# --- Shared / Core Keys ---
OPENROUTER_API_KEY=
TAVILY_API_KEY=
GROQ_API_KEY=
SERPER_API_KEY=
DATABASE_URL=sqlite:///./nexaflow_pipeline.db

# --- Research & Qualify Module ---
# Toggle: "mock" (default, no API keys needed) or "live" (real search + LLM)
RESEARCH_MODE=mock
# LLM provider for live research extraction: "anthropic" (default) or "openai"
LLM_PROVIDER=anthropic
# Search provider for live research: "tavily" (default) or "serper"
SEARCH_PROVIDER=tavily

# --- Outreach Pipeline Module ---
# LLM (Email drafting / response classification)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-3-5-sonnet-20241022

# Email Dispatch
GMAIL_USER=
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM=outreach@nexaflow.ai
EMAIL_REPLY_TO=

# Timing & Automation Settings
FOLLOW_UP_DELAY_DAYS=3
MAX_FOLLOW_UPS=1
BRIEFING_LEAD_TIME_MIN=30
